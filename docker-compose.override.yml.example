# Docker Compose Override 示例文件
#
# 用途：
# - 在不修改主配置文件的情况下覆盖或添加配置
# - 适合存放环境特定的配置（开发环境、生产环境等）
# - 避免 git pull 时的配置冲突
#
# 使用方法：
# 1. 复制此文件为 docker-compose.override.yml
#    cp docker-compose.override.yml.example docker-compose.override.yml
# 2. 根据你的需求修改配置
# 3. 运行 docker compose up -d，配置会自动合并
#
# 注意：docker-compose.override.yml 已被加入 .gitignore，不会提交到 Git

services:
  web:
    # 示例：修改端口映射（如果 5000 端口被占用）
    # ports:
    #   - "8080:5000"

    # 示例：添加额外的 volume 挂载
    # volumes:
    #   - ./custom_path:/app/custom_path

    # 示例：覆盖或添加环境变量
    # environment:
    #   - DEBUG=true
    #   - CUSTOM_VAR=value

    # 示例：连接到 Nginx 反向代理网络
    # 如果启用下方的 nginx_dev 服务，取消下面的注释
    # networks:
    #   - default
    #   - nginx-proxy-network

  # ==========================================
  # 前端开发环境配置（nginx_dev）
  # ==========================================
  # 使用方法：
  # 1. 取消下方所有注释
  # 2. 运行 docker compose up -d
  # 3. 访问 http://localhost 查看前端页面
  # ==========================================

  # 前端构建服务
  # frontend-build:
  #   build:
  #     context: ./frontend
  #     dockerfile: Dockerfile
  #   container_name: yewfence-frontend-build
  #   volumes:
  #     # 将构建产物保存到共享 volume
  #     - frontend-dist:/app/dist
  #   command: sh -c "echo 'Frontend build completed. Files are in /app/dist'"

  # Nginx 开发服务
  # nginx_dev:
  #   build:
  #     context: ./nginx
  #     dockerfile: Dockerfile
  #   container_name: yewfence-nginx-dev
  #   ports:
  #     - "80:80"
  #   volumes:
  #     # 从 frontend-build 服务读取构建产物
  #     - frontend-dist:/usr/share/nginx/html:ro
  #   depends_on:
  #     - frontend-build
  #     - web
  #   networks:
  #     - nginx-proxy-network
  #   restart: unless-stopped

# 定义共享 volume（如果启用 nginx_dev 需要取消注释）
# volumes:
#   frontend-dist:
#     driver: local

# 定义网络（如果启用 nginx_dev 需要取消注释）
networks:
  nginx-proxy-network:
    driver: bridge
    # external: true  # 如果使用外部网络，取消此行注释
