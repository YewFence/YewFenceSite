# Docker Compose Override 示例文件
#
# 使用方法：
# 1. 复制此文件为 docker-compose.override.yml
#    cp docker-compose.override.yml.example docker-compose.override.yml
# 2. 根据你的需求修改配置
# 3. 运行 docker compose up -d，配置会自动合并
#
# 注意：docker-compose.override.yml 已被加入 .gitignore，不会提交到 Git

services:
  frontend:
    networks:
      - nginx-proxy-network
  backend:
    # 示例：连接到 Nginx 反向代理网络
    # 如果启用下方的 nginx_dev 服务，取消下面的注释
    networks:
      - nginx-proxy-network

# 定义外部nginx docker网络
networks:
  nginx-proxy-network:
    external: true  # 如果使用外部网络，取消此行注释
