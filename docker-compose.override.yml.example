# Docker Compose Override 示例文件
#
# 用途：
# - 在不修改主配置文件的情况下覆盖或添加配置
# - 适合存放环境特定的配置（开发环境、生产环境等）
# - 避免 git pull 时的配置冲突
#
# 使用方法：
# 1. 复制此文件为 docker-compose.override.yml
#    cp docker-compose.override.yml.example docker-compose.override.yml
# 2. 根据你的需求修改配置
# 3. 运行 docker compose up -d，配置会自动合并
#
# 注意：docker-compose.override.yml 已被加入 .gitignore，不会提交到 Git

services:
  web:
    # 示例：修改端口映射（如果 5000 端口被占用）
    # ports:
    #   - "8080:5000"

    # 示例：添加额外的 volume 挂载
    # volumes:
    #   - ./custom_path:/app/custom_path

    # 示例：覆盖或添加环境变量
    # environment:
    #   - DEBUG=true
    #   - CUSTOM_VAR=value

    # 示例：连接到 Nginx 反向代理网络
    # 如果你使用 nginx-proxy 或 Traefik 等反向代理，取消下面的注释
    networks:
      - default
      - nginx-proxy-network

# 定义外部网络（需要提前创建）
networks:
  nginx-proxy-network:
    external: true
